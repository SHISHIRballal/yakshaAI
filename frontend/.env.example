# ── Chatbot (Required) ──────────────────────────────────────────────────────
# Get free key at https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Backend URL (Required in Production) ────────────────────────────────────
# Your Render backend URL — leave empty for local dev
VITE_API_URL=https://your-backend.onrender.com

# ── WebSocket URL (Required in Production) ──────────────────────────────────
# Same as API URL but with wss:// prefix
VITE_WS_URL=wss://your-backend.onrender.com
